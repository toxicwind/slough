# slough configuration — copy to .env (or export directly)
# Every value has a sane default in src/config.ts; this file documents them.

# adb binary
MOLT_ADB=/usr/bin/adb

# Phone IP on your LAN (the port is auto-discovered — wireless ADB rotates it)
MOLT_PIXEL_IP=10.0.0.77

# Comma-separated /sdcard dirs to back up (photos excluded by design)
MOLT_SOURCES=Download,Documents,Export,1openfang,Tasker,House

# Parallel pull streams (8 is the benchmarked sweet spot)
MOLT_PARALLEL=8

# Archive root on your server
MOLT_DEST=/mnt/8TB/phone-archive
